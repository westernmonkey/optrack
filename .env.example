# OpTrack environment template — copy to .env and fill in values.
# Never commit a real .env file.

SERPER_API_KEY=your_serper_api_key

# Comma-separated OpenRouter keys (free tier rotates across keys)
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallbacks:
# OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free,google/gemma-4-31b-it:free

NOTION_TOKEN=secret_your_notion_integration_token
NOTION_DB_ID=your_notion_database_id
